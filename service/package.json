{
  "name": "nexus-provenance-service",
  "version": "1.0.0",
  "description": "Nexus Reasoning Provenance Graph Service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest --testEnvironment=node --forceExit"
  },
  "dependencies": {
    "@xenova/transformers": "2.17.2",
    "better-sqlite3": "11.10.0",
    "cors": "2.8.5",
    "express": "4.22.1",
    "openai": "4.28.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/uuid": "^10.0.0",
    "jest": "29.7.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {}]
    }
  }
}
